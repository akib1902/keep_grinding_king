# ---------------------------------------------------------------------------
# Resilient Multi-Step Financial Research & Settlement Agent — environment
# Copy to `.env` and adjust. Never commit real credentials.
# ---------------------------------------------------------------------------

# Runtime: development | test | production
NODE_ENV=development
LOG_LEVEL=info

# --- API process ---
API_HOST=127.0.0.1
API_PORT=3100
# Public origin used in returned resource URLs and strict origin checks on mutations.
APP_ORIGIN=http://127.0.0.1:3100
# Comma-separated allowed CORS origins. Empty disables CORS handling.
CORS_ORIGINS=

# --- PostgreSQL (authoritative store) ---
DATABASE_URL=postgresql://rfa:rfa@127.0.0.1:55432/rfa?schema=public
# Dedicated database used by integration/e2e tests.
TEST_DATABASE_URL=postgresql://rfa:rfa@127.0.0.1:55432/rfa_test?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://127.0.0.1:56379
QUEUE_PREFIX=rfa
QUEUE_NAME=run-execution
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000

# --- Auth ---
# HMAC secret for the local JWT issuer. MUST be replaced outside local development.
JWT_SECRET=local-dev-only-secret-change-me-0123456789
JWT_ISSUER=resilient-financial-agent
JWT_AUDIENCE=resilient-financial-agent-api
# Local development token minting endpoint (POST /api/auth/dev-token). Disable in production.
ENABLE_DEV_TOKENS=true

# --- Agent execution budgets (PR-09 / SRS-AGENT-004..006) ---
AGENT_MAX_TOOL_CALLS=6
AGENT_DEADLINE_MS=30000
AGENT_MAX_MODEL_RETRIES=2
AGENT_TOKEN_BUDGET=24000

# --- LLM provider adapter ---
# mock = fully deterministic, offline. Use it for tests and the default demo.
# openai-compatible = any OpenAI-compatible /chat/completions endpoint with tool calling
# (OpenAI, Azure OpenAI, OpenLLM gateway, vLLM, Ollama, ...).
LLM_PROVIDER=mock
LLM_MODEL=unset
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_API_KEY=

# --- Financial policy (deterministic, versioned) ---
# Amounts are integer minor units (cents). 50000 = USD 500.00
POLICY_APPROVAL_THRESHOLD_MINOR=50000
POLICY_CURRENCY=USD
POLICY_VERSION=v1

# --- Approval workflow ---
APPROVAL_TTL_SECONDS=3600

# --- Recovery worker ---
RECOVERY_INTERVAL_MS=30000
# A RUNNING attempt with no heartbeat for this long is considered stale.
STALE_ATTEMPT_MS=60000
