{
  "name": "resilient-financial-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Resilient Multi-Step Financial Research & Settlement Agent — asynchronous AI research with deterministic financial controls, human approval and idempotent simulated settlement.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "start:api": "node dist/src/api/main.js",
    "start:worker": "node dist/src/worker/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:wait": "tsx scripts/wait-for-infra.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:test:prepare": "tsx scripts/prepare-test-db.ts",
    "seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web dev",
    "web:build": "npm --prefix web build",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:test": "npm --prefix web run test",
    "verify:web": "npm --prefix web run typecheck && npm --prefix web run test",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test:all"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bullmq": "^5.58.0",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "pino": "^9.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
